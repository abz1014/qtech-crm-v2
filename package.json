  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:import": "vitest run --config import/vitest.config.ts",
    "import:report": "tsx import/src/cli.ts report",
    "import:i06": "tsx import/src/cli.ts i06",
    "import:load": "tsx import/src/cli.ts load",
    "import:fixtures": "node import/fixtures/build-legacy-dump.mjs",
    "check:tokens": "node scripts/check-token-parity.mjs",
    "build:e2e": "vite build --mode development --outDir dist-e2e",
    "test:e2e": "playwright test --project=w1440 --project=w375",
    "test:e2e:update": "playwright test e2e/gallery.visual.spec.ts --project=w1440 --project=w375 --update-snapshots"
  },
